# Copy to .env and fill in values. Never commit .env.
# Names only — this file must never contain real values.

# --- Search providers ---
# Comma-separated, in priority order. First configured provider is primary.
SEARCH_PROVIDERS=perplexity,google
# fallback: try providers in order per query until one returns results
# fanout:   query every configured provider and merge results
SEARCH_STRATEGY=fallback

PERPLEXITY_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Search limits ---
SEARCH_TIMEOUT_S=15
SEARCH_MAX_RESULTS=10
SEARCH_MAX_RETRIES=1
SEARCH_CONCURRENCY=4
SEARCH_CIRCUIT_BREAKER_THRESHOLD=3

LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Research API (local/internal; binds localhost by default) ---
API_HOST=127.0.0.1
API_PORT=8000
API_MAX_BODY_BYTES=16384
JOB_TIMEOUT_S=600
JOB_SEARCH_TIMEOUT_S=300
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20

# --- Crawler (Sprint 04; standalone, not yet used by jobs) ---
CRAWL_TIMEOUT_S=15
CRAWL_CONNECT_TIMEOUT_S=5
CRAWL_READ_TIMEOUT_S=10
CRAWL_MAX_RESPONSE_BYTES=5242880
CRAWL_MAX_REDIRECTS=5
CRAWL_RETRIES=1
CRAWL_RETRY_BACKOFF_S=1
CRAWL_CONCURRENCY=5
CRAWL_PER_HOST_CONCURRENCY=1
CRAWL_PER_HOST_MIN_INTERVAL_S=1
CRAWL_ROBOTS_TIMEOUT_S=5
CRAWL_ROBOTS_MAX_BYTES=524288
CRAWL_ROBOTS_CACHE_TTL_S=86400
# Optional extra CA bundle path (e.g. TLS inspection). TLS verification is always on.
# CRAWL_CA_BUNDLE=
